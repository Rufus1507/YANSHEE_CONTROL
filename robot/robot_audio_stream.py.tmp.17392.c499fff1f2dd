"""
robot_audio_stream.py — Stream âm thanh output từ Yanshee sang loa máy tính.

Hoạt động tương tự luồng camera MJPEG:
  Camera  : HTTP GET  /stream.mjpg  → JPEG frames → hiển thị lên màn hình
  Audio   : SSH exec  arecord/parec → raw PCM     → phát qua loa máy tính

Kiến trúc:
  - Chạy trên thread riêng (daemon) — không block asyncio loop
  - Giao tiếp với hệ thống qua EventBus
  - Hỗ trợ bật/tắt on-the-fly, auto-reconnect khi mất kết nối

Cấu hình (config.py):
  ROBOT_AUDIO_STREAM_ENABLED = False  → tắt
  ROBOT_AUDIO_STREAM_ENABLED = True   → bật (stream về loa PC đồng thời với loa Yanshee)

Yêu cầu:
  pip install pyaudio paramiko
  Trên robot cần: PulseAudio (parec) hoặc ALSA (arecord)
"""

import threading
import time
from logs.logger import get_logger
import configs as _cfg

logger = get_logger(__name__)


class RobotAudioStream:
    """
    Stream audio output của Yanshee robot về loa máy tính theo thời gian thực.

    Interface giống CameraManager:
        stream = RobotAudioStream(event_bus)
        stream.start()       # bắt đầu stream
        stream.stop()        # dừng stream
        stream.is_running    # trạng thái hiện tại
    """

    def __init__(self, event_bus=None):
        self._bus = event_bus
        self._stop_event = threading.Event()
        self._thread: threading.Thread | None = None
        self._running = False
        self._ssh = None

    # ── Lifecycle ─────────────────────────────────────────────────────────────

    def start(self) -> bool:
        """Khởi động luồng stream audio từ robot."""
        if self._running:
            logger.warning("[AUDIO-STREAM] Đã đang chạy, bỏ qua start().")
            return True
        self._stop_event.clear()
        self._thread = threading.Thread(
            target=self._stream_loop,
            name="RobotAudioStream",
            daemon=True,
        )
        self._thread.start()
        self._running = True
        logger.info("[AUDIO-STREAM] Luồng audio stream đã khởi động.")
        self._emit("started")
        return True

    def stop(self):
        """Dừng stream audio (graceful shutdown)."""
        self._stop_event.set()
        self._running = False
        if self._thread and self._thread.is_alive():
            self._thread.join(timeout=5)
        self._cleanup()
        logger.info("[AUDIO-STREAM] Luồng audio stream đã dừng.")
        self._emit("stopped")

    @property
    def is_running(self) -> bool:
        return self._running and self._thread is not None and self._thread.is_alive()

    # ── Core stream loop (chạy trên thread riêng) ─────────────────────────────

    def _stream_loop(self):
        """
        Vòng lặp chính:
          1. SSH vào Yanshee
          2. Chạy lệnh capture audio output (parec / arecord)
          3. Đọc raw PCM chunk-by-chunk từ stdout pipe
          4. Phát real-time qua pyaudio (loa máy tính)
          5. Auto-reconnect nếu mất kết nối
        """
        while not self._stop_event.is_set():
            pa = None
            audio_out = None
            ssh = None
            try:
                self._emit("connecting")
                logger.info(
                    f"[AUDIO-STREAM] Đang kết nối SSH tới {_cfg.YANSHEE_IP}:{_cfg.ROBOT_SSH_PORT}..."
                )

                # ── 1. SSH ───────────────────────────────────────────────────
                import paramiko
                ssh = paramiko.SSHClient()
                ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
                ssh.connect(
                    _cfg.YANSHEE_IP,
                    port=_cfg.ROBOT_SSH_PORT,
                    username=_cfg.ROBOT_SSH_USER,
                    password=_cfg.ROBOT_SSH_PASS,
                    timeout=10,
                )
                self._ssh = ssh
                logger.info("[AUDIO-STREAM] SSH kết nối thành công.")

                # ── 2. Chạy lệnh capture ──────────────────────────────────────
                cmd = _cfg.ROBOT_AUDIO_CAPTURE_CMD
                logger.info(f"[AUDIO-STREAM] Capture cmd: {cmd}")
                transport = ssh.get_transport()
                channel = transport.open_session()
                channel.exec_command(cmd)

                # ── 3. Khởi tạo pyaudio output ────────────────────────────────
                pa, audio_out = self._init_pyaudio()
                if audio_out is None:
                    logger.error("[AUDIO-STREAM] Không thể mở pyaudio — bỏ qua.")
                    ssh.close()
                    time.sleep(3)
                    continue

                self._emit("streaming")
                logger.info(
                    f"[AUDIO-STREAM] Đang stream: "
                    f"{_cfg.ROBOT_AUDIO_SAMPLE_RATE} Hz / "
                    f"{'Stereo' if _cfg.ROBOT_AUDIO_CHANNELS == 2 else 'Mono'}"
                )

                # ── 4. Vòng lặp đọc PCM → phát loa ───────────────────────────
                stdout = channel.makefile("rb")
                while not self._stop_event.is_set():
                    if channel.exit_status_ready():
                        logger.warning("[AUDIO-STREAM] Lệnh capture trên robot đã kết thúc.")
                        break
                    chunk = stdout.read(_cfg.ROBOT_AUDIO_CHUNK_BYTES)
                    if not chunk:
                        break
                    try:
                        audio_out.write(chunk)
                    except Exception as e:
                        logger.warning(f"[AUDIO-STREAM] Lỗi phát audio: {e}")
                        break

            except ImportError:
                logger.error(
                    "[AUDIO-STREAM] Thiếu thư viện. Chạy: pip install paramiko pyaudio"
                )
                self._emit("error")
                break

            except Exception as e:
                if not self._stop_event.is_set():
                    logger.warning(f"[AUDIO-STREAM] Lỗi: {e}. Thử lại sau 5s...")
                    self._emit("error")
                    time.sleep(5)

            finally:
                self._close_pyaudio(pa, audio_out)
                if ssh:
                    try:
                        ssh.close()
                    except Exception:
                        pass
                if not self._stop_event.is_set():
                    logger.info("[AUDIO-STREAM] Reconnect sau 3 giây...")
                    time.sleep(3)

        self._running = False
        logger.info("[AUDIO-STREAM] Vòng lặp stream đã kết thúc.")

    # ── Helpers ───────────────────────────────────────────────────────────────

    def _init_pyaudio(self):
        """Khởi tạo pyaudio output stream trên loa máy tính."""
        try:
            import pyaudio
            pa = pyaudio.PyAudio()
            stream = pa.open(
                format=pyaudio.paInt16,
                channels=_cfg.ROBOT_AUDIO_CHANNELS,
                rate=_cfg.ROBOT_AUDIO_SAMPLE_RATE,
                output=True,
                frames_per_buffer=_cfg.ROBOT_AUDIO_CHUNK_BYTES // 2,
            )
            return pa, stream
        except ImportError:
            logger.error("[AUDIO-STREAM] Thiếu pyaudio. Chạy: pip install pyaudio")
            return None, None
        except Exception as e:
            logger.error(f"[AUDIO-STREAM] Lỗi khởi tạo pyaudio: {e}")
            return None, None

    def _close_pyaudio(self, pa, stream):
        try:
            if stream:
                stream.stop_stream()
                stream.close()
            if pa:
                pa.terminate()
        except Exception:
            pass

    def _cleanup(self):
        if self._ssh:
            try:
                self._ssh.close()
            except Exception:
                pass
            self._ssh = None

    def _emit(self, status: str):
        if self._bus:
            self._bus.emit("ROBOT_AUDIO_STREAM_STATUS", {"status": status})


# ─────────────────────────────────────────────────────────────────────────────
# Standalone test — chạy trực tiếp để test:
#   python -m robot.robot_audio_stream
# ─────────────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    import sys
    import os
    sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

    if sys.platform == "win32":
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")

    print("=" * 60)
    print("  ROBOT AUDIO STREAM — TEST MODE")
    print(f"  Robot IP   : {_cfg.YANSHEE_IP}:{_cfg.ROBOT_SSH_PORT}")
    print(f"  Sample rate: {_cfg.ROBOT_AUDIO_SAMPLE_RATE} Hz")
    print(f"  Channels   : {'Stereo' if _cfg.ROBOT_AUDIO_CHANNELS == 2 else 'Mono'}")
    print(f"  Capture cmd: {_cfg.ROBOT_AUDIO_CAPTURE_CMD}")
    print("=" * 60)
    print("\nNhấn Ctrl+C để dừng.\n")

    audio_stream = RobotAudioStream(event_bus=None)
    audio_stream.start()

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n[TEST] Đang dừng...")
        audio_stream.stop()
        print("[TEST] Đã dừng.")
